# Kopyala: cp .env.example .env
#
# Ngrok (önerilen — fiziksel telefon):
# EXPO_PUBLIC_API_BASE_URL=https://SENIN-SUBDOMAIN.ngrok-free.dev
#
# Aynı Wi‑Fi, dotnet 0.0.0.0:5274 dinliyorsa:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.64:5274
#
# Android emülatör (PC’deki localhost):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5274

EXPO_PUBLIC_API_BASE_URL=https://your-subdomain.ngrok-free.dev
