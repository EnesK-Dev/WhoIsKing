@model AskAway.Models.QuestionFormViewModel

<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="Text" class="form-label"></label>
    <textarea asp-for="Text" class="form-control" rows="3" required placeholder="Soru metnini yazın"></textarea>
    <span asp-validation-for="Text" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="QuestionType" class="form-label"></label>
    <select asp-for="QuestionType" class="form-select" id="questionTypeSelect">
        <option value="@((int)AskAway.Models.QuestionType.MultipleChoice)">Çoktan seçmeli — şıkları burada girersiniz</option>
        <option value="@((int)AskAway.Models.QuestionType.PlayerSelection)">Oyuncu seçme — şıklar oyunda odadaki isimler olur</option>
        <option value="@((int)AskAway.Models.QuestionType.PlayerOptions)">Oyuncu katılımlı — şıkları oyuncular oyunda yazar</option>
    </select>
</div>

<div class="mb-3" id="optionsBlock">
    <label asp-for="OptionsText" class="form-label"></label>
    <textarea asp-for="OptionsText" class="form-control font-monospace" rows="5"
              id="optionsText"
              placeholder="Her satıra bir şık veya virgülle ayırın. En az 2, en çok 5 şık (A–E)."></textarea>
    <div class="form-text">Çoktan seçmeli dışındaki tiplerde bu alan kullanılmaz.</div>
    <span asp-validation-for="OptionsText" class="text-danger"></span>

    <div class="mt-3">
        <span class="form-label d-block">Veya satır ekleyin</span>
        <div id="dynamicOptions" class="vstack gap-2"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="addOptionRow">Şık satırı ekle</button>
    </div>
</div>
