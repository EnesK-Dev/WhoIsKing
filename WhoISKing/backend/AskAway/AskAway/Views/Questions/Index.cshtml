@model AskAway.Models.QuestionsIndexViewModel

@{
    ViewData["Title"] = "Soru yönetimi";
    Layout = null;
    var total = Model.MultipleChoice.Count + Model.PlayerSelection.Count + Model.PlayerOptions.Count;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span class="navbar-brand mb-0 h1">Admin — Sorular</span>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-light btn-sm" asp-action="Create">Yeni soru</a>
                <a class="btn btn-outline-light btn-sm" asp-action="CreateFromJson">JSON ile ekle</a>
                <form asp-controller="Admin" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Çıkış</button>
                </form>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        @if (TempData["JsonImportMessage"] is string importMsg)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @importMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }
        @if (total == 0)
        {
            <div class="alert alert-info">Henüz soru yok. <a asp-action="Create">İlk soruyu ekleyin</a>.</div>
        }
        else
        {
            <p class="text-muted small mb-3">Toplam <strong>@total</strong> soru — tipe göre aşağıda gruplandı.</p>

            <ul class="nav nav-pills flex-wrap gap-2 mb-4" role="tablist">
                <li class="nav-item" role="presentation">
                    <a class="nav-link active" id="tab-mc" data-bs-toggle="tab" href="#panel-mc" role="tab">Çoktan seçmeli (@Model.MultipleChoice.Count)</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" id="tab-ps" data-bs-toggle="tab" href="#panel-ps" role="tab">Oyuncu seçme (@Model.PlayerSelection.Count)</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a class="nav-link" id="tab-po" data-bs-toggle="tab" href="#panel-po" role="tab">Oyuncu katılımlı (@Model.PlayerOptions.Count)</a>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="panel-mc" role="tabpanel" aria-labelledby="tab-mc">
                    <partial name="_QuestionSection" model="@(new QuestionSectionViewModel { AnchorId = "sec-mc", Title = "Çoktan seçmeli", Questions = Model.MultipleChoice })" />
                </div>
                <div class="tab-pane fade" id="panel-ps" role="tabpanel" aria-labelledby="tab-ps">
                    <partial name="_QuestionSection" model="@(new QuestionSectionViewModel { AnchorId = "sec-ps", Title = "Oyuncu seçme", Questions = Model.PlayerSelection })" />
                </div>
                <div class="tab-pane fade" id="panel-po" role="tabpanel" aria-labelledby="tab-po">
                    <partial name="_QuestionSection" model="@(new QuestionSectionViewModel { AnchorId = "sec-po", Title = "Oyuncu katılımlı", Questions = Model.PlayerOptions })" />
                </div>
            </div>
        }

        <p class="mt-3"><a class="btn btn-link" asp-controller="Home" asp-action="Index">← Ana sayfa</a></p>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
